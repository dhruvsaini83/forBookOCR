# ==============================================================================
# VaniScript Heritage OCR & Manuscript Preservation - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Cloudflare R2 / S3-Compatible Object Storage Credentials
# ------------------------------------------------------------------------------
# Create an API Token in Cloudflare Dashboard:
# Manage Account -> R2 -> Manage R2 API Tokens -> Create API Token (Object Read & Write)

# 1. Cloudflare R2 S3 Endpoint URL
# Format: https://<cloudflare_account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com

# 2. R2 API Access Key ID
R2_ACCESS_KEY=your_r2_access_key_id

# 3. R2 API Secret Access Key
R2_SECRET_KEY=your_r2_secret_access_key

# 4. R2 Bucket Name (Default: vaniscript)
R2_BUCKET=vaniscript

# 5. Optional: Custom Domain or Public Bucket URL (e.g., https://pub-xxx.r2.dev or https://cdn.yourdomain.com)
# When set, generated file URLs will use this public base URL instead of the private endpoint
R2_PUBLIC_URL=https://cdn.vaniscript.com

# ------------------------------------------------------------------------------
# Local Storage & Database Paths
# ------------------------------------------------------------------------------
# STORAGE_DIR=backend/storage
# DB_PATH=backend/storage/preservation.db

# ------------------------------------------------------------------------------
# OCR & System Configuration
# ------------------------------------------------------------------------------
# TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata
# PORT=8000
# ENVIRONMENT=production

